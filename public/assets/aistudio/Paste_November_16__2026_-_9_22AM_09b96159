                state.equipped.top = { item: WARDROBE.top[3], color: '#be185d' };
                state.equipped.bottom = { item: WARDROBE.bottom[2], color: '#451a03' };
                state.equipped.outer = { item: WARDROBE.outer[3], color: '#991b1b' };
                state.equipped.accessory = null;
