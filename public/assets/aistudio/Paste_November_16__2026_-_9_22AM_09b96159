        function resetPoseJoints() {
            state.poseJoints = { turn: 0, armL: 15, armR: 15, legSpread: 8 };
            syncPoseSliders();
            draw();
        }
        function clearAiResult() {
            state.aiResultImg = null;
            state.compareMode = false;
            document.getElementById('compareOverlay').classList.add('hidden');
            document.getElementById('btnCompareAi').classList.add('hidden');
            document.getElementById('btnBackOverlay').classList.add('hidden');
            document.getElementById('canvasStatusTitle').textContent = 'Pratinjau Studio';
            draw();
