        function syncPoseSliders() {
            document.getElementById('rngBodyTurn').value = state.poseJoints.turn;
            document.getElementById('rngArmL').value = state.poseJoints.armL;
            document.getElementById('rngArmR').value = state.poseJoints.armR;
