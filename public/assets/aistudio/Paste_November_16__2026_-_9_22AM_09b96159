                    hand_on_hip: 'standing confidently with hand resting on hip',
                    sitting_casual: 'sitting casually on a studio stool'
                };
                const poseText = poseDescriptions[state.model.pose] || 'standing natural posture';

                const poseSpec = state.mode === 'ai'
                    ? `Exact body posture to preserve 100%: ${poseText}, body rotation ${j.turn} degrees, left arm angle ${j.armL} degrees, right arm angle ${j.armR} degrees, leg stance spread ${j.legSpread} degrees, subject gender: ${state.model.gender === 'female' ? 'Indonesian woman' : 'Indonesian man'}.`
                    : `STRICT 100% IDENTITY & POSTURE LOCK: Preserve the exact person from the uploaded image with ZERO changes to their face shape, facial landmarks, eyes, nose, mouth, skin tone, hair, exact body posture, limb angles, hand positions, body proportions, and background environment.`;

                const prompt = `High-precision photorealistic virtual try-on image editing. Edit ONLY the clothing on the exact subject in the input image so they are wearing this exact mix-and-match outfit: [${items.join('; ')}].
${poseSpec}
