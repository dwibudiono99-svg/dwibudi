            document.getElementById('lblBodyTurn').textContent = state.poseJoints.turn + '°';
            document.getElementById('lblArmL').textContent = state.poseJoints.armL + '°';
            document.getElementById('lblArmR').textContent = state.poseJoints.armR + '°';
            document.getElementById('lblLegSpread').textContent = state.poseJoints.legSpread + '°';
