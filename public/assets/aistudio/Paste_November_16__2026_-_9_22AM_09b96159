                const cleanCanvas = document.createElement('canvas');
                cleanCanvas.width = W;
                cleanCanvas.height = H;
                const cleanCtx = cleanCanvas.getContext('2d');
                drawCleanSubjectOnly(cleanCtx);
                const base64CleanSubject = cleanCanvas.toDataURL('image/png').split(',')[1];

                const j = state.poseJoints;
                const touchupMap = {
                    natural: 'Keep the face 100% identical to the original subject without changing facial structure, features, eyes, nose, lips, or expression.',
                    bright_smooth: 'Keep the exact original facial structure, bone structure, and identity 100% unchanged, only apply subtle natural skin brightening and soft studio lighting on the face.',
                    gentle_smile: 'Keep the exact original facial structure, eyes, nose, and identity 100% unchanged, with only a very subtle natural gentle smile.',
                    light_makeup: 'Keep the exact original facial structure and identity 100% unchanged, adding only subtle natural everyday makeup and fresh studio skin tone.',
                    clean_groomed: 'Keep the exact original facial structure and identity 100% unchanged, with clean well-lit editorial portrait retouching.'
                };
                const faceInstruction = touchupMap[state.faceAdjust.touchup] || touchupMap.natural;

                const poseDescriptions = {
                    standing_front: 'standing straight facing forward',
