            document.getElementById('selFaceTouchup').value = 'natural';
            updateFaceFilters();
        }

        function randomizeModel() {
            const genders = ['female', 'male'];
            const hairs = ['bun', 'long', 'bob', 'hijab', 'short', 'undercut'];
            const poses = ['standing_front', 'side_casual', 'walking_runway', 'hand_on_hip', 'sitting_casual'];
            state.model.gender = genders[Math.floor(Math.random() * genders.length)];
            state.model.hair = hairs[Math.floor(Math.random() * hairs.length)];
            state.model.pose = poses[Math.floor(Math.random() * poses.length)];
            state.model.skin = SKINS[Math.floor(Math.random() * SKINS.length)];
            state.model.bgIdx = Math.floor(Math.random() * BACKDROPS.length);
            document.getElementById('selGender').value = state.model.gender;
            document.getElementById('selHair').value = state.model.hair;
            document.getElementById('selPose').value = state.model.pose;
            renderSwatches();
            updateModel();
        }

        function randomizeAll() {
            const pick = arr => arr[Math.floor(Math.random() * arr.length)];
            state.equipped.fullset = null;
            state.equipped.top = { item: pick(WARDROBE.top), color: pick(PALETTE) };
            state.equipped.bottom = { item: pick(WARDROBE.bottom), color: pick(PALETTE) };
            state.equipped.outer = Math.random() > 0.4 ? { item: pick(WARDROBE.outer), color: pick(PALETTE) } : null;
            state.equipped.accessory = Math.random() > 0.45 ? { item: pick(WARDROBE.accessory), color: pick(PALETTE) } : null;
            state.aiResultImg = null;
            renderTray(); renderColorSwatches(); renderItems(); draw();
            toast('Kombinasi gaya acak diterapkan!');
        }

        function clearOutfit() {
            state.aiResultImg = null;
            state.equipped = { top: null, bottom: null, outer: null, accessory: null, fullset: null };
            renderTray(); renderItems(); draw();
        }

