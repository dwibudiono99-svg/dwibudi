                state.equipped.outer = { item: WARDROBE.outer[1], color: '#2563eb' };
                state.equipped.accessory = { item: WARDROBE.accessory[2], color: '#09090b' };
            } else if (type === 'renang') {
                state.equipped.top = { item: WARDROBE.top[6], color: '#0284c7' };
                state.equipped.bottom = { item: WARDROBE.bottom[6], color: '#0f172a' };
                state.equipped.outer = null;
                state.equipped.accessory = { item: WARDROBE.accessory[3], color: '#eab308' };
            } else {
                state.equipped.top = { item: WARDROBE.top[8], color: '#10b981' };
                state.equipped.bottom = { item: WARDROBE.bottom[7], color: '#27272a' };
                state.equipped.outer = { item: WARDROBE.outer[2], color: '#d97706' };
                state.equipped.accessory = null;
            }
            renderTray(); renderColorSwatches(); renderItems(); draw();
        }

        function handleUpload(e) {
            const file = e.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = ev => {
                const img = new Image();
                img.onload = () => {
                    state.aiResultImg = null;
                    state.photo = { img, scale: 1, y: 0 };
                    const ctrl = document.getElementById('photoControls');
                    ctrl.classList.remove('hidden');
                    ctrl.style.display = 'flex';
                    draw();
                    toast('Foto berhasil dimuat!');
                };
                img.src = ev.target.result;
            };
            reader.readAsDataURL(file);
            e.target.value = '';
        }

        function updatePhotoAdjust() {
            const s = +document.getElementById('rngBgScale').value;
            const y = +document.getElementById('rngBgY').value;
            state.photo.scale = s / 100;
            state.photo.y = y;
            document.getElementById('lblBgScale').textContent = s + '%';
            document.getElementById('lblBgY').textContent = y + 'px';
            draw();
        }

        function updateTransform() {
            const s = +document.getElementById('rngScale').value;
            const r = +document.getElementById('rngRot').value;
            const w = +document.getElementById('rngWidth').value;
            state.transform.scale = s / 100;
            state.transform.rot = r;
            state.transform.width = w / 100;
            document.getElementById('lblScale').textContent = s + '%';
            document.getElementById('lblRot').textContent = r + '°';
            document.getElementById('lblWidth').textContent = w + '%';
