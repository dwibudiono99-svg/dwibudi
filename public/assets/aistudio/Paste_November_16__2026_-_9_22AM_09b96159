- Tailor and drape the specified garments naturally over the existing body posture with realistic fabric folds, seams, and shadows matching the subject's exact position.
- Image tone & lighting: brightness ${state.faceAdjust.brightness}%, contrast ${state.faceAdjust.contrast}%, photography style: ${photoStyle}. Additional subtle lighting/camera note (without changing pose or face): "${directorNote}".`;

                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;
                const payload = {
                    contents: [{
                        role: 'user',
                        parts: [
                            { text: prompt },
                            { inlineData: { mimeType: 'image/png', data: base64CleanSubject } }
                        ]
                    }],
                    generationConfig: {
                        responseModalities: ['TEXT', 'IMAGE'],
                        imageConfig: { aspectRatio: "3:4" }
                    }
                };

                let result = null, delay = 1000;
                for (let attempt = 0; attempt < 3; attempt++) {
                    const res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (res.ok) { result = await res.json(); break; }
                    await new Promise(r => setTimeout(r, delay));
                    delay *= 2;
                }

                const part = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
                if (part?.inlineData?.data) {
                    const img = new Image();
                    img.onload = () => {
                        state.aiResultImg = img;
                        state.compareMode = false;
                        document.getElementById('compareOverlay').classList.add('hidden');
                        const btnCmp = document.getElementById('btnCompareAi');
                        btnCmp.classList.remove('hidden');
                        btnCmp.textContent = 'Bandingkan Asli';
                        document.getElementById('btnBackOverlay').classList.remove('hidden');
                        document.getElementById('canvasStatusTitle').textContent = 'Hasil AI (100% Presisi Postur & Wajah)';
                        loader.classList.add('hidden');
                        draw();
                        toast('✨ Selesai! Pakaian terpasang presisi mengikuti postur & wajah asli.');
                    };
                    img.src = `data:${part.inlineData.mimeType || 'image/png'};base64,${part.inlineData.data}`;
                } else {
                    throw new Error('No image generated');
                }
            } catch (err) {
                loader.classList.add('hidden');
                toast('Gagal memuat render AI, menampilkan pratinjau proporsional.');
            }
        }

        function toast(msg) {
            const el = document.getElementById('toast');
            el.textContent = msg;
            el.classList.add('show');
            setTimeout(() => el.classList.remove('show'), 2400);
        }

        function shade(col, pct) {
            const num = parseInt(col.replace('#', ''), 16), amt = Math.round(2.55 * pct);
            const R = (num >> 16) + amt, B = ((num >> 8) & 0x00FF) + amt, G = (num & 0x0000FF) + amt;
            return '#' + (0x1000000 + (R < 255 ? (R < 1 ? 0 : R) : 255) * 0x10000 +
                (B < 255 ? (B < 1 ? 0 : B) : 255) * 0x100 + (G < 255 ? (G < 1 ? 0 : G) : 255)).toString(16).slice(1);
        }

        function rRect(x, y, w, h, r) {
            rRectOn(ctx, x, y, w, h, r);
        }
        function rRectOn(c, x, y, w, h, r) {
            c.beginPath();
            c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r);
            c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r);
            c.arcTo(x, y, x + w, y, r); c.closePath();
        }
