        function toggleCompareAi() {
            if (!state.aiResultImg) return;
            state.compareMode = !state.compareMode;
            const ov = document.getElementById('compareOverlay');
            const btn = document.getElementById('btnCompareAi');
            if (state.compareMode) {
                ov.classList.remove('hidden');
                btn.textContent = 'Tutup Bandingkan';
            } else {
                ov.classList.add('hidden');
                btn.textContent = 'Bandingkan Asli';
            }
            draw();
        }
        function bindCompareDrag() {
            const ov = document.getElementById('compareOverlay');
            const div = document.getElementById('compareDivider');
            let active = false;
            const update = e => {
                const r = canvas.getBoundingClientRect();
                const cx = e.touches ? e.touches[0].clientX : e.clientX;
                const ratio = Math.max(0.05, Math.min(0.95, (cx - r.left) / r.width));
                state.compareRatio = ratio;
                div.style.left = (ratio * 100) + '%';
                draw();
            };
            ov.addEventListener('mousedown', e => { active = true; update(e); });
            window.addEventListener('mousemove', e => { if (active) update(e); });
            window.addEventListener('mouseup', () => { active = false; });
            ov.addEventListener('touchstart', e => { active = true; update(e); }, { passive: true });
            window.addEventListener('touchmove', e => { if (active) update(e); }, { passive: true });
            window.addEventListener('touchend', () => { active = false; });
        }
        function setSkin(hex) { state.aiResultImg = null; state.model.skin = hex; renderSwatches(); draw(); }
        function setBg(idx) { state.aiResultImg = null; state.model.bgIdx = idx; renderSwatches(); draw(); }

        function updateFaceFilters() {
            state.faceAdjust.brightness = +document.getElementById('rngBright').value;
            state.faceAdjust.contrast = +document.getElementById('rngContrast').value;
