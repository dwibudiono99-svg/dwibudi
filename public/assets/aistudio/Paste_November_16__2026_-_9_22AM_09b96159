        // 6. DRAG & UTILITAS
        function bindDrag() {
            const getPos = e => {
                const r = canvas.getBoundingClientRect();
                const cx = e.touches ? e.touches[0].clientX : e.clientX;
                const cy = e.touches ? e.touches[0].clientY : e.clientY;
                return { x: (cx - r.left) * (W / r.width), y: (cy - r.top) * (H / r.height) };
            };
            const down = e => {
                const p = getPos(e);
                state.dragging = true;
                state.dragStart = { x: p.x - state.transform.x, y: p.y - state.transform.y };
            };
            const move = e => {
                if (!state.dragging) return;
                e.preventDefault();
                const p = getPos(e);
                state.transform.x = p.x - state.dragStart.x;
                state.transform.y = p.y - state.dragStart.y;
                draw();
            };
            const up = () => { state.dragging = false; };

            canvas.addEventListener('mousedown', down);
            window.addEventListener('mousemove', move);
            window.addEventListener('mouseup', up);
            canvas.addEventListener('touchstart', down, { passive: false });
            window.addEventListener('touchmove', move, { passive: false });
            window.addEventListener('touchend', up);
        }

        function downloadPNG() {
            const a = document.createElement('a');
            a.download = `outfit-mixmatch-${Date.now()}.png`;
            a.href = canvas.toDataURL('image/png');
            a.click();
            toast('Gambar PNG berhasil diunduh!');
        }

        // 7. GENERATOR AI MIX & MATCH SESUAI POSE & ARAHAN FOTOGRAFER
        async function generateAiMixMatch() {
            const items = [];
            if (state.equipped.fullset) {
                items.push(`Setelan lengkap: ${state.equipped.fullset.item.name} (${state.equipped.fullset.item.desc}) warna ${state.equipped.fullset.color}`);
