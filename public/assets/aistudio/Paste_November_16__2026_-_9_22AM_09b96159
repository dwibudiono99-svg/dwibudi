        }

        // 5. MESIN RENDER KANVAS RINGAN (2D VECTOR)
        function drawCleanSubjectOnly(targetCtx = ctx) {
            targetCtx.clearRect(0, 0, W, H);
            const fa = state.faceAdjust;
            const sepiaPct = Math.max(0, fa.warmth);
            const saturatePct = 100 + fa.warmth * 0.5;
            targetCtx.filter = `brightness(${fa.brightness}%) contrast(${fa.contrast}%) sepia(${sepiaPct}%) saturate(${saturatePct}%)`;

            if (state.mode === 'upload') {
                targetCtx.fillStyle = '#13161b';
                targetCtx.fillRect(0, 0, W, H);
                if (state.photo.img) {
                    const img = state.photo.img;
                    const asp = img.width / img.height;
                    let dh = H * state.photo.scale, dw = dh * asp;
                    if (dw < W * state.photo.scale) { dw = W * state.photo.scale; dh = dw / asp; }
                    targetCtx.drawImage(img, (W - dw) / 2, (H - dh) / 2 + state.photo.y, dw, dh);
                } else {
                    targetCtx.filter = 'none';
                    targetCtx.fillStyle = '#6b7280';
                    targetCtx.font = '600 14px system-ui';
                    targetCtx.textAlign = 'center';
                    targetCtx.fillText('Unggah foto pada panel kiri', W / 2, H / 2);
                }
            } else {
                drawAvatarModel(targetCtx);
            }
            targetCtx.filter = 'none';
        }

        function draw() {
            ctx.clearRect(0, 0, W, H);

            // Jika hasil AI sudah dirender, tampilkan langsung (atau mode perbandingan belah layar)
            if (state.aiResultImg) {
                const img = state.aiResultImg;
                const asp = img.width / img.height;
                let dh = H, dw = dh * asp;
                if (dw < W) { dw = W; dh = dw / asp; }

                if (state.compareMode) {
                    ctx.drawImage(img, (W - dw) / 2, (H - dh) / 2, dw, dh);
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(0, 0, W * state.compareRatio, H);
                    ctx.clip();
                    drawCleanSubjectOnly(ctx);
                    ctx.restore();
                } else {
                    ctx.drawImage(img, (W - dw) / 2, (H - dh) / 2, dw, dh);
                }
                return;
            }

            // A. Gambar Latar & Subjek Bersih
            drawCleanSubjectOnly(ctx);

            // B. Gambar Layer Pakaian (mengikuti sudut rotasi tubuh proporsional)
            const bodySkewRad = (state.poseJoints.turn * 0.35 * Math.PI) / 180;
            ctx.save();
            ctx.translate(W / 2 + state.transform.x, H / 2 + state.transform.y);
            ctx.rotate(((state.transform.rot + state.poseJoints.turn * 0.25) * Math.PI) / 180);
            ctx.transform(1, 0, Math.tan(bodySkewRad) * 0.3, 1, 0, 0);
            ctx.scale(0.75 * state.transform.scale * state.transform.width, 0.75 * state.transform.scale);

            if (state.equipped.fullset) {
                drawGarment(state.equipped.fullset.item.shape, state.equipped.fullset.color);
            } else {
                if (state.equipped.bottom) drawGarment(state.equipped.bottom.item.shape, state.equipped.bottom.color);
                if (state.equipped.top) drawGarment(state.equipped.top.item.shape, state.equipped.top.color);
                if (state.equipped.outer) drawGarment(state.equipped.outer.item.shape, state.equipped.outer.color);
            }
            if (state.equipped.accessory) {
                drawGarment(state.equipped.accessory.item.shape, state.equipped.accessory.color);
            }
            ctx.restore();
        }

        function drawAvatarModel(targetCtx = ctx) {
            const c = targetCtx;
            const bg = BACKDROPS[state.model.bgIdx];
            const g = c.createLinearGradient(0, 0, 0, H);
            g.addColorStop(0, bg[0]); g.addColorStop(1, bg[1]);
            c.fillStyle = g;
            c.fillRect(0, 0, W, H);

            const cx = W / 2, skin = state.model.skin, fem = state.model.gender === 'female', pose = state.model.pose;
            const joints = state.poseJoints;
            const turnOffset = joints.turn * 0.45; // Pergeseran perspektif 3/4 proporsional

            // Bayangan lantai
            c.fillStyle = 'rgba(0,0,0,0.25)';
            c.beginPath(); c.ellipse(cx, 558, 85, 13, 0, 0, Math.PI * 2); c.fill();

            // Rambut belakang
            if (state.model.hair === 'long') {
                c.fillStyle = '#1c1917';
                rRectOn(c, cx - 40 - turnOffset * 0.3, 98, 80, 130, 30); c.fill();
            }

            // Leher & Badan
            c.fillStyle = shade(skin, -15);
            rRectOn(c, cx - 13, 144, 26, 36, 8); c.fill();

            c.fillStyle = skin;
            const perspectiveScale = 1 - Math.abs(joints.turn) * 0.005;
            const sw = (fem ? 55 : 66) * perspectiveScale, ww = (fem ? 36 : 48) * perspectiveScale;
            c.beginPath();
            c.moveTo(cx - sw + turnOffset * 0.2, 185); c.lineTo(cx + sw + turnOffset * 0.2, 185);
            c.lineTo(cx + ww, 326); c.lineTo(cx - ww, 326);
            c.closePath(); c.fill();

            // Lengan proporsional mengikuti sudut sendi bahu & siku
            c.lineCap = 'round'; c.lineWidth = fem ? 16 : 20; c.strokeStyle = skin;
            const radL = (joints.armL * Math.PI) / 180;
            const radR = (joints.armR * Math.PI) / 180;
            const shLX = cx - sw + 4 + turnOffset * 0.2, shRX = cx + sw - 4 + turnOffset * 0.2, shY = 192;

            if (pose === 'sitting_casual') {
                c.fillStyle = '#3f3f46';
                rRectOn(c, cx - 54, 364, 108, 12, 5); c.fill();
                c.fillRect(cx - 38, 376, 8, 175); c.fillRect(cx + 30, 376, 8, 175);
            }

            // Lengan Kiri (dengan sendi siku proporsional)
            const elbLX = shLX - Math.sin(radL) * 72;
            const elbLY = shY + Math.cos(radL) * 72;
            const handLX = joints.armL > 42 ? cx - ww - 4 : elbLX - Math.sin(radL * 0.5) * 66;
            const handLY = joints.armL > 42 ? 312 : elbLY + Math.cos(radL * 0.5) * 66;
            c.beginPath(); c.moveTo(shLX, shY); c.lineTo(elbLX, elbLY); c.lineTo(handLX, handLY); c.stroke();

            // Lengan Kanan (dengan sendi siku proporsional)
            const elbRX = shRX + Math.sin(radR) * 72;
            const elbRY = shY + Math.cos(radR) * 72;
            const handRX = joints.armR > 42 ? cx + ww + 4 : elbRX + Math.sin(radR * 0.5) * 66;
            const handRY = joints.armR > 42 ? 312 : elbRY + Math.cos(radR * 0.5) * 66;
            c.beginPath(); c.moveTo(shRX, shY); c.lineTo(elbRX, elbRY); c.lineTo(handRX, handRY); c.stroke();

            // Kaki proporsional mengikuti bukaan langkah pinggul
            c.lineWidth = fem ? 20 : 23; c.strokeStyle = skin;
            const spreadRad = (joints.legSpread * Math.PI) / 180;
            const hipLX = cx - 18, hipRX = cx + 18, hipY = 326;
            if (pose === 'sitting_casual') {
                c.beginPath(); c.moveTo(hipLX, hipY); c.lineTo(cx - 32, 375); c.lineTo(cx - 32, 540); c.stroke();
                c.beginPath(); c.moveTo(hipRX, hipY); c.lineTo(cx + 32, 375); c.lineTo(cx + 32, 540); c.stroke();
            } else {
                const footLX = hipLX - Math.sin(spreadRad) * 145;
                const footRX = hipRX + Math.sin(spreadRad) * 145;
                c.beginPath(); c.moveTo(hipLX, hipY); c.lineTo(footLX, 545); c.stroke();
                c.beginPath(); c.moveTo(hipRX, hipY); c.lineTo(footRX, 545); c.stroke();
            }

            // Kepala & Wajah (mengikuti arah hadap & ekspresi wajah umum)
            c.fillStyle = skin;
            c.beginPath(); c.ellipse(cx + turnOffset * 0.15, 117, 31, 37, 0, 0, Math.PI * 2); c.fill();
            c.fillStyle = '#18181b';
            const eyeShift = turnOffset * 0.35;
            c.beginPath(); c.arc(cx - 11 + eyeShift, 114, 2.5, 0, Math.PI * 2); c.arc(cx + 11 + eyeShift, 114, 2.5, 0, Math.PI * 2); c.fill();

            // Riasan pipi halus jika memilih riasan ringan
            if (state.faceAdjust.touchup === 'light_makeup' || state.faceAdjust.touchup === 'bright_smooth') {
                c.fillStyle = 'rgba(244, 114, 182, 0.22)';
                c.beginPath();
                c.arc(cx - 15 + eyeShift, 122, 5.5, 0, Math.PI * 2);
                c.arc(cx + 15 + eyeShift, 122, 5.5, 0, Math.PI * 2);
                c.fill();
            }

            c.strokeStyle = state.faceAdjust.touchup === 'light_makeup' ? '#be185d' : '#9f5848';
            c.lineWidth = 1.8;
            c.beginPath();
            if (state.faceAdjust.touchup === 'gentle_smile') {
                c.arc(cx + eyeShift, 127, 9, 0.1 * Math.PI, 0.9 * Math.PI);
            } else {
                c.arc(cx + eyeShift, 129, 7, 0.15 * Math.PI, 0.85 * Math.PI);
            }
            c.stroke();

            // Rambut / Hijab
            const h = state.model.hair;
            if (h === 'hijab') {
                c.fillStyle = '#334155';
                c.beginPath(); c.arc(cx + turnOffset * 0.15, 122, 40, Math.PI * 0.85, Math.PI * 2.15);
                c.quadraticCurveTo(cx + 48, 175, cx + 32, 205);
                c.quadraticCurveTo(cx, 215, cx - 32, 205);
                c.quadraticCurveTo(cx - 48, 175, cx - 38, 135);
                c.fill();
            } else {
                c.fillStyle = '#1c1917';
                if (h === 'bun') { c.beginPath(); c.arc(cx - turnOffset * 0.2, 76, 18, 0, Math.PI * 2); c.fill(); }
                c.beginPath(); c.arc(cx + turnOffset * 0.15, 114, 36, Math.PI * 0.95, Math.PI * 2.05); c.fill();
            }
        }

        function drawGarment(shape, color) {
            ctx.save();
            ctx.fillStyle = color;
            ctx.strokeStyle = shade(color, -25);
            ctx.lineWidth = 2;

            if (['pants', 'cargo'].includes(shape)) {
                ctx.beginPath();
                ctx.moveTo(-60, 40); ctx.lineTo(60, 40); ctx.lineTo(66, 330); ctx.lineTo(14, 330);
                ctx.lineTo(0, 115); ctx.lineTo(-14, 330); ctx.lineTo(-66, 330);
                ctx.closePath(); ctx.fill(); ctx.stroke();
            } else if (['skirt_batik', 'skirt_songket'].includes(shape)) {
                ctx.beginPath();
                ctx.moveTo(-62, 40); ctx.lineTo(62, 40); ctx.lineTo(74, 325); ctx.lineTo(-74, 325);
                ctx.closePath(); ctx.fill(); ctx.stroke();
                ctx.strokeStyle = shape === 'skirt_songket' ? 'rgba(245,158,11,0.55)' : 'rgba(255,255,255,0.25)';
                for (let y = 75; y <= 300; y += 38) { ctx.beginPath(); ctx.moveTo(-64, y); ctx.lineTo(64, y); ctx.stroke(); }
            } else if (shape === 'shorts') {
                ctx.beginPath();
                ctx.moveTo(-60, 40); ctx.lineTo(60, 40); ctx.lineTo(64, 155); ctx.lineTo(10, 155);
                ctx.lineTo(0, 105); ctx.lineTo(-10, 155); ctx.lineTo(-64, 155);
                ctx.closePath(); ctx.fill(); ctx.stroke();
            } else if (['shirt_batik', 'shirt_pocket', 'shirt_formal', 'blouse', 'kebaya', 'rashguard'].includes(shape)) {
                const bottomY = shape === 'kebaya' ? 82 : 48;
                ctx.beginPath();
                ctx.moveTo(-36, -162); ctx.lineTo(36, -162); ctx.lineTo(100, -135); ctx.lineTo(124, 24);
                ctx.lineTo(94, 28); ctx.lineTo(74, -80); ctx.lineTo(64, bottomY); ctx.lineTo(-64, bottomY);
                ctx.lineTo(-74, -80); ctx.lineTo(-94, 28); ctx.lineTo(-124, 24); ctx.lineTo(-100, -135);
                ctx.closePath(); ctx.fill(); ctx.stroke();
                if (shape.startsWith('shirt') || shape === 'kebaya') drawCollar();
            } else if (['tshirt', 'oversize'].includes(shape)) {
                const ex = shape === 'oversize' ? 14 : 0;
                ctx.beginPath();
                ctx.moveTo(-36, -160); ctx.quadraticCurveTo(0, -135, 36, -160);
                ctx.lineTo(96 + ex, -134); ctx.lineTo(116 + ex, -48); ctx.lineTo(84 + ex, -36);
                ctx.lineTo(68 + ex, -82); ctx.lineTo(62 + ex, 48 + ex); ctx.lineTo(-62 - ex, 48 + ex);
                ctx.lineTo(-68 - ex, -82); ctx.lineTo(-84 - ex, -36); ctx.lineTo(-116 - ex, -48);
                ctx.lineTo(-96 - ex, -134); ctx.closePath(); ctx.fill(); ctx.stroke();
            } else if (shape === 'bikini') {
                ctx.beginPath();
                ctx.moveTo(-48, -108); ctx.lineTo(-10, -108); ctx.lineTo(-6, -68); ctx.lineTo(-54, -68); ctx.closePath();
                ctx.moveTo(48, -108); ctx.lineTo(10, -108); ctx.lineTo(6, -68); ctx.lineTo(54, -68); ctx.closePath();
                ctx.fill(); ctx.stroke();
            } else if (shape === 'blazer') {
                ctx.beginPath();
                ctx.moveTo(-42, -164); ctx.lineTo(-12, -164); ctx.lineTo(-12, 68); ctx.lineTo(-68, 68);
                ctx.lineTo(-78, -80); ctx.lineTo(-96, 32); ctx.lineTo(-126, 26); ctx.lineTo(-102, -136); ctx.closePath();
                ctx.moveTo(42, -164); ctx.lineTo(12, -164); ctx.lineTo(12, 68); ctx.lineTo(68, 68);
                ctx.lineTo(78, -80); ctx.lineTo(96, 32); ctx.lineTo(126, 26); ctx.lineTo(102, -136); ctx.closePath();
                ctx.fill(); ctx.stroke();
            } else if (shape === 'sash') {
                ctx.beginPath();
                ctx.moveTo(-78, -155); ctx.lineTo(-42, -155); ctx.lineTo(74, 85); ctx.lineTo(38, 85);
                ctx.closePath(); ctx.fill(); ctx.stroke();
            } else if (['full_suit', 'full_dress', 'onepiece'].includes(shape)) {
                const len = shape === 'onepiece' ? 130 : 320;
                ctx.beginPath();
                ctx.moveTo(-36, -162); ctx.lineTo(36, -162); ctx.lineTo(98, -135); ctx.lineTo(116, 15);
                ctx.lineTo(88, 20); ctx.lineTo(70, -80); ctx.lineTo(66, len); ctx.lineTo(-66, len);
                ctx.lineTo(-70, -80); ctx.lineTo(-88, 20); ctx.lineTo(-116, 15); ctx.lineTo(-98, -135);
                ctx.closePath(); ctx.fill(); ctx.stroke();
            } else if (shape === 'peci') {
                rRect(-44, -312, 88, 34, 8); ctx.fill(); ctx.stroke();
            } else if (shape === 'hijab') {
                ctx.beginPath(); ctx.arc(0, -264, 58, Math.PI * 0.85, Math.PI * 2.15);
                ctx.quadraticCurveTo(68, -185, 48, -142); ctx.quadraticCurveTo(0, -124, -48, -142);
                ctx.quadraticCurveTo(-68, -185, -54, -245); ctx.fill(); ctx.stroke();
            } else if (shape === 'glasses') {
                rRect(-36, -276, 30, 16, 4); ctx.fill();
                rRect(6, -276, 30, 16, 4); ctx.fill();
            } else if (shape === 'sunhat') {
                ctx.beginPath(); ctx.ellipse(0, -296, 95, 18, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
                ctx.beginPath(); ctx.arc(0, -296, 46, Math.PI, Math.PI * 2); ctx.fill(); ctx.stroke();
            } else if (shape === 'bag') {
