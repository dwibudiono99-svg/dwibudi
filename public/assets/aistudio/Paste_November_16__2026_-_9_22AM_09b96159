            ['#1e1b4b', '#09090b'],
            ['#334155', '#0f172a'],
            ['#fce7f3', '#e0e7ff'],
            ['#fb923c', '#be185d']
        ];

        // 2. STATE APLIKASI
        const state = {
            mode: 'ai',
            model: { gender: 'female', skin: '#d89b74', hair: 'bun', pose: 'standing_front', bgIdx: 0 },
            poseJoints: { turn: 0, armL: 15, armR: 15, legSpread: 8 },
            faceAdjust: { brightness: 100, contrast: 100, warmth: 0, touchup: 'natural' },
            photo: { img: null, scale: 1, y: 0 },
            aiResultImg: null,
            compareMode: false,
            compareRatio: 0.5,
            activeTab: 'top',
            filter: 'all',
            equipped: {
                top: { item: WARDROBE.top[0], color: WARDROBE.top[0].color },
                bottom: { item: WARDROBE.bottom[0], color: WARDROBE.bottom[0].color },
                outer: null,
                accessory: null,
                fullset: null
            },
            transform: { x: 0, y: 24, scale: 1, width: 1, rot: 0 },
            dragging: false,
            dragStart: { x: 0, y: 0 }
        };

        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const W = 450, H = 600; // Resolusi ringan & tajam
        canvas.width = W;
        canvas.height = H;

        // 3. INISIALISASI
        window.onload = () => {
            renderSwatches();
            renderSlotTabs();
            renderFilters();
            renderTray();
            renderColorSwatches();
            renderItems();
            bindDrag();
            bindCompareDrag();
            draw();
