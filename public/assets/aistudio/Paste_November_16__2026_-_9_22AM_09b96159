<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Outfit Mix & Match (Versi Ringan)</title>
    <style>
        :root {
            --bg: #0f1115;
            --card: #181b21;
            --card-alt: #20242c;
            --border: #2c313c;
            --text: #f3f4f6;
            --muted: #9ca3af;
            --primary: #6366f1;
            --accent: #f59e0b;
            --danger: #ef4444;
            --radius: 12px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
        body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }

        /* Header */
        header {
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 12px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            position: sticky;
            top: 0;
            z-index: 20;
        }
        .brand { display: flex; align-items: center; gap: 10px; }
        .brand-badge {
            width: 34px; height: 34px; border-radius: 9px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            display: grid; place-items: center; font-weight: 800; font-size: 16px; color: #fff;
        }
        .brand h1 { font-size: 15px; font-weight: 700; }
        .brand span { font-size: 11px; color: var(--muted); display: block; }

        .btn {
            border: 1px solid var(--border);
            background: var(--card-alt);
            color: var(--text);
            padding: 8px 12px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.15s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn:hover { border-color: #4b5563; background: #282d37; }
        .btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
        .btn-primary:hover { background: #4f46e5; }
        .btn-accent { background: var(--accent); border-color: var(--accent); color: #111827; }
        .btn-accent:hover { background: #d97706; }

        /* Main Grid */
        main {
            flex: 1;
            max-width: 1360px;
            width: 100%;
            margin: 0 auto;
            padding: 14px;
            display: grid;
            grid-template-columns: 280px 1fr 340px;
            gap: 14px;
        }
        @media (max-width: 1024px) {
            main { grid-template-columns: 1fr; }
        }

        .panel {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .panel-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Tabs & Controls */
        .tab-group {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            background: var(--bg);
            padding: 4px;
            border-radius: 9px;
            border: 1px solid var(--border);
            gap: 4px;
        }
        .tab-btn {
            background: transparent;
            border: none;
            color: var(--muted);
            padding: 7px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 7px;
            cursor: pointer;
        }
        .tab-btn.active { background: var(--primary); color: #fff; }

        label.field-label { font-size: 11px; color: var(--muted); display: block; margin-bottom: 4px; }
        select, input[type="text"] {
            width: 100%;
            background: var(--bg);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 12px;
            outline: none;
        }
        select:focus, input[type="text"]:focus { border-color: var(--primary); }

        .swatch-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .swatch {
            width: 22px; height: 22px; border-radius: 50%;
            border: 2px solid var(--border);
            cursor: pointer;
            transition: transform 0.1s;
        }
        .swatch.active { border-color: var(--accent); transform: scale(1.15); }

        /* Canvas Area */
        .canvas-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }
        .canvas-frame {
            width: 100%;
            max-width: 390px;
            aspect-ratio: 3 / 4;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            overflow: hidden;
            background: #13161b;
            position: relative;
        }
        canvas {
            width: 100%;
            height: 100%;
            display: block;
            cursor: grab;
            touch-action: none;
        }
        canvas:active { cursor: grabbing; }
        .canvas-hint {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 17, 21, 0.8);
            padding: 4px 10px;
            border-radius: 99px;
            font-size: 11px;
            color: #d1d5db;
            white-space: nowrap;
            pointer-events: none;
        }

        .slider-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            background: var(--bg);
            padding: 10px;
            border-radius: 9px;
            border: 1px solid var(--border);
        }
        .slider-item label { font-size: 10px; color: var(--muted); display: flex; justify-content: space-between; margin-bottom: 4px; }
        input[type="range"] { width: 100%; accent-color: var(--accent); cursor: pointer; }

        /* Wardrobe & Tray */
        .tray-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .tray-slot {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 9px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            cursor: pointer;
        }
        .tray-slot.active { border-color: var(--primary); }
        .tray-info { min-width: 0; }
        .tray-info small { font-size: 10px; color: var(--muted); display: block; }
        .tray-info strong { font-size: 11px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .dot { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); flex-shrink: 0; }

        .slot-tabs {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 4px;
            background: var(--bg);
            padding: 4px;
            border-radius: 9px;
            border: 1px solid var(--border);
        }
        .slot-tab {
            background: transparent; border: none; color: var(--muted);
            padding: 6px 2px; font-size: 11px; font-weight: 600; border-radius: 6px; cursor: pointer;
        }
        .slot-tab.active { background: var(--primary); color: #fff; }

        .pills { display: flex; gap: 4px; overflow-x: auto; padding-bottom: 2px; }
        .pill {
            background: var(--card-alt); border: 1px solid var(--border); color: var(--muted);
            padding: 4px 9px; border-radius: 99px; font-size: 11px; cursor: pointer; white-space: nowrap;
        }
        .pill.active { background: var(--accent); color: #111827; border-color: var(--accent); font-weight: 700; }

        .items-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            max-height: 310px;
            overflow-y: auto;
            padding-right: 2px;
        }
        .item-card {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 9px;
            cursor: pointer;
            transition: 0.12s;
        }
        .item-card:hover { border-color: #4b5563; }
        .item-card.selected { border-color: var(--primary); background: rgba(99, 102, 241, 0.12); }
        .item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .item-tag { font-size: 9px; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; background: var(--card-alt); color: var(--muted); }
        .item-card h4 { font-size: 12px; font-weight: 600; margin-bottom: 2px; }
        .item-card p { font-size: 10px; color: var(--muted); line-height: 1.3; }

        .hidden { display: none !important; }
        .upload-box {
            border: 2px dashed var(--border);
            border-radius: 10px;
            padding: 20px 12px;
            text-align: center;
            cursor: pointer;
            background: var(--bg);
            font-size: 12px;
            color: var(--muted);
        }
        .upload-box:hover { border-color: var(--primary); color: var(--text); }

        .btn-ai {
            width: 100%;
            background: linear-gradient(135deg, var(--primary), #9333ea, var(--accent));
            border: none;
            color: #fff;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
            transition: transform 0.15s, opacity 0.15s;
        }
        .btn-ai:hover { opacity: 0.95; transform: translateY(-1px); }

        .loader-overlay {
            position: absolute;
            inset: 0;
            background: rgba(15, 17, 21, 0.85);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 18px;
            z-index: 15;
        }
        .compare-overlay {
            position: absolute;
            inset: 0;
            cursor: ew-resize;
            z-index: 12;
            user-select: none;
            touch-action: none;
        }
        .compare-divider {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--accent);
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.9);
            left: 50%;
        }
        .compare-handle {
            position: absolute;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--accent);
            color: #111827;
            font-weight: 800;
            font-size: 11px;
            display: grid;
            place-items: center;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }
        .compare-badge {
            position: absolute;
            top: 10px;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            pointer-events: none;
        }
        .spinner {
            width: 34px; height: 34px;
            border: 3px solid rgba(255,255,255,0.2);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 10px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        #toast {
            position: fixed; bottom: 16px; right: 16px;
            background: #1f2937; border: 1px solid var(--primary); color: #fff;
            padding: 10px 14px; border-radius: 9px; font-size: 12px;
            opacity: 0; pointer-events: none; transition: 0.2s; z-index: 50;
        }
        #toast.show { opacity: 1; }
    </style>
</head>
<body>

    <div id="toast"></div>

    <header>
        <div class="brand">
            <div class="brand-badge">OM</div>
            <div>
                <h1>Studio Outfit Mix & Match</h1>
                <span>Versi Ringan & Cepat • Tanpa Loading</span>
            </div>
        </div>
        <div style="display:flex; gap:8px;">
            <button class="btn" onclick="randomizeAll()">Acak Gaya</button>
            <button class="btn btn-primary" onclick="downloadPNG()">Unduh PNG</button>
        </div>
    </header>

    <main>
        <!-- KOLOM 1: MODEL & POSE -->
        <section class="panel">
            <div class="panel-title">
                <span>1. Model & Pose</span>
                <button class="btn" style="padding:3px 8px; font-size:11px;" onclick="randomizeModel()">Acak Model</button>
            </div>

            <div class="tab-group">
                <button id="btnModeAi" class="tab-btn active" onclick="setSubjectMode('ai')">Model Avatar</button>
                <button id="btnModeUpload" class="tab-btn" onclick="setSubjectMode('upload')">Upload Foto</button>
            </div>

            <!-- Panel Model Avatar -->
            <div id="panelAi" style="display:flex; flex-direction:column; gap:10px;">
                <div>
                    <label class="field-label">Posisi / Pose Tubuh</label>
                    <select id="selPose" onchange="updateModel()">
                        <option value="standing_front">Berdiri Tegak Frontal</option>
                        <option value="side_casual">Pose Santai 3/4</option>
                        <option value="walking_runway">Berjalan Runway</option>
                        <option value="hand_on_hip">Tangan di Pinggang</option>
                        <option value="sitting_casual">Duduk Kasual</option>
                    </select>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                    <div>
                        <label class="field-label">Gender</label>
                        <select id="selGender" onchange="updateModel()">
                            <option value="female">Wanita</option>
                            <option value="male">Pria</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Rambut / Hijab</label>
                        <select id="selHair" onchange="updateModel()">
                            <option value="bun">Sanggul / Cepol</option>
                            <option value="long">Panjang Terurai</option>
                            <option value="bob">Bob Modern</option>
                            <option value="hijab">Hijab Modern</option>
                            <option value="short">Pendek Rapi</option>
                            <option value="undercut">Undercut</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="field-label">Warna Kulit</label>
                    <div id="skinSwatches" class="swatch-row"></div>
                </div>

                <div>
                    <label class="field-label">Latar Belakang</label>
                    <div id="bgSwatches" class="swatch-row"></div>
                </div>

                <!-- Kontrol Pose Proporsional -->
                <div style="border-top:1px solid var(--border); padding-top:8px; display:flex; flex-direction:column; gap:6px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <label class="field-label" style="margin:0;">Atur Pose Proporsional</label>
                        <button class="btn" style="padding:2px 6px; font-size:10px;" onclick="resetPoseJoints()">Reset Pose</button>
                    </div>
                    <div class="slider-item">
                        <label><span>Sudut Badan / Rotasi</span><span id="lblBodyTurn">0°</span></label>
                        <input type="range" id="rngBodyTurn" min="-25" max="25" value="0" oninput="updatePoseJoints()">
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                        <div class="slider-item">
                            <label><span>Lengan Kiri</span><span id="lblArmL">15°</span></label>
                            <input type="range" id="rngArmL" min="-35" max="75" value="15" oninput="updatePoseJoints()">
                        </div>
                        <div class="slider-item">
                            <label><span>Lengan Kanan</span><span id="lblArmR">15°</span></label>
                            <input type="range" id="rngArmR" min="-35" max="75" value="15" oninput="updatePoseJoints()">
                        </div>
                    </div>
                    <div class="slider-item">
                        <label><span>Langkah Kaki / Pinggul</span><span id="lblLegSpread">8°</span></label>
                        <input type="range" id="rngLegSpread" min="0" max="28" value="8" oninput="updatePoseJoints()">
                    </div>
                </div>
            </div>

            <!-- Panel Upload Foto -->
            <div id="panelUpload" class="hidden" style="flex-direction:column; gap:10px;">
                <label for="fileUploadInput" class="upload-box" style="display:block;">
                    <strong>Klik untuk pilih foto</strong><br>
                    <small>JPG, PNG, WebP dari perangkat Anda</small>
                </label>
                <input id="fileUploadInput" type="file" accept="image/*" class="hidden" onchange="handleUpload(event)">
                <div id="photoControls" class="hidden" style="flex-direction:column; gap:8px;">
                    <div class="slider-item">
                        <label><span>Zoom Foto</span><span id="lblBgScale">100%</span></label>
                        <input type="range" id="rngBgScale" min="60" max="170" value="100" oninput="updatePhotoAdjust()">
                    </div>
                    <div class="slider-item">
                        <label><span>Geser Atas/Bawah</span><span id="lblBgY">0px</span></label>
                        <input type="range" id="rngBgY" min="-150" max="150" value="0" oninput="updatePhotoAdjust()">
                    </div>
                </div>
            </div>

            <!-- Kecerahan & Fitur Wajah Umum (Tanpa Mengubah Struktur Wajah Asli) -->
            <div style="border-top:1px solid var(--border); padding-top:10px; display:flex; flex-direction:column; gap:7px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label class="field-label" style="margin:0; font-weight:700; color:var(--text);">Kecerahan & Wajah Umum</label>
                    <button class="btn" style="padding:2px 6px; font-size:10px;" onclick="resetFaceFilters()">Reset</button>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    <div class="slider-item">
                        <label><span>Kecerahan</span><span id="lblBright">100%</span></label>
                        <input type="range" id="rngBright" min="70" max="140" value="100" oninput="updateFaceFilters()">
                    </div>
                    <div class="slider-item">
                        <label><span>Kontras</span><span id="lblContrast">100%</span></label>
                        <input type="range" id="rngContrast" min="75" max="135" value="100" oninput="updateFaceFilters()">
                    </div>
                </div>
                <div class="slider-item">
                    <label><span>Tone Cerah Kulit (Warmth)</span><span id="lblWarmth">0%</span></label>
                    <input type="range" id="rngWarmth" min="-20" max="30" value="0" oninput="updateFaceFilters()">
                </div>
                <div>
                    <label class="field-label">Penyesuaian Wajah Umum (Bentuk Tetap Asli)</label>
                    <select id="selFaceTouchup" onchange="updateFaceFilters()">
                        <option value="natural">Asli Apa Adanya (Tanpa Ubah Wajah)</option>
                        <option value="bright_smooth">Cerah Halus Natural (Soft Glow)</option>
                        <option value="gentle_smile">Senyum Ramah Natural</option>
                        <option value="light_makeup">Riasan Natural Ringan (Fresh Look)</option>
                        <option value="clean_groomed">Tampilan Segar & Rapi (Studio Retouch)</option>
                    </select>
                </div>
            </div>

            <!-- Preset Cepat -->
            <div style="border-top:1px solid var(--border); padding-top:10px; display:flex; flex-direction:column; gap:6px;">
                <label class="field-label">Paket Mix & Match Cepat</label>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    <button class="btn" onclick="applyQuickPreset('dinas')">Dinas Kantor</button>
                    <button class="btn" onclick="applyQuickPreset('adat')">Adat Kebaya</button>
                    <button class="btn" onclick="applyQuickPreset('casual')">Casual Denim</button>
                    <button class="btn" onclick="applyQuickPreset('renang')">Renang Pantai</button>
                    <button class="btn" style="grid-column:span 2;" onclick="applyQuickPreset('santai')">Santai Rumahan</button>
                </div>
            </div>
        </section>

        <!-- KOLOM 2: KANVAS INTERAKTIF -->
        <section class="panel canvas-box">
            <div class="panel-title" style="width:100%;">
                <span id="canvasStatusTitle">Pratinjau Studio</span>
                <div style="display:flex; gap:6px;">
                    <button id="btnCompareAi" class="btn hidden" style="padding:3px 8px; font-size:11px; border-color:var(--accent); color:var(--accent);" onclick="toggleCompareAi()">Bandingkan Asli</button>
                    <button id="btnBackOverlay" class="btn hidden" style="padding:3px 8px; font-size:11px;" onclick="clearAiResult()">Edit Overlay</button>
                    <button class="btn" style="padding:3px 8px; font-size:11px;" onclick="resetTransform()">Reset Posisi</button>
                </div>
            </div>

            <div class="canvas-frame">
                <canvas id="canvas"></canvas>
                <div id="compareOverlay" class="compare-overlay hidden">
                    <div id="compareDivider" class="compare-divider">
                        <div class="compare-handle">⇄</div>
                    </div>
                    <span class="compare-badge" style="left:10px; background:rgba(0,0,0,0.7);">MODEL ASLI</span>
                    <span class="compare-badge" style="right:10px; background:var(--primary);">HASIL AI (100% IDENTIK)</span>
                </div>
                <div id="canvasLoader" class="loader-overlay hidden">
                    <div class="spinner"></div>
                    <strong style="font-size:13px; margin-bottom:4px;">AI Fotografer & Stylist Bekerja...</strong>
                    <small id="loaderDesc" style="font-size:11px; color:var(--muted);">Mengunci 100% wajah asli & postur tubuh model sambil memasang busana</small>
                </div>
                <div class="canvas-hint">Seret baju pada layar atau klik tombol AI Mix & Match di bawah</div>
            </div>

            <!-- Arahan Fotografer & Tombol Eksekusi AI -->
            <div style="width:100%; background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:10px; display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label class="field-label" style="margin:0; font-weight:700; color:var(--accent);">Arahan Fotografer (Director Mode)</label>
                    <select id="selPhotoStyle" style="width:auto; padding:4px 8px; font-size:11px;">
                        <option value="Editorial Lookbook Studio, pencahayaan softbox tajam, lensa 85mm">Editorial Lookbook</option>
                        <option value="Street Fashion Candid siang hari, latar arsitektur kota modern, bokeh alami">Street Fashion</option>
                        <option value="Potret Formal Eksekutif / Kantor, pencahayaan bersih & berwibawa">Formal Studio</option>
                        <option value="Golden Hour Pantai Tropis, cahaya matahari senja hangat">Golden Hour Pantai</option>
                        <option value="Royal Heritage Budaya Nusantara, nuansa klasik megah">Royal Heritage Adat</option>
                    </select>
                </div>
                <input type="text" id="txtDirectorNote" placeholder="Arahan pose & kamera (mis: tatap kamera percaya diri, tangan di saku, angle low-shot)..." value="Pose natural proporsional menghadap kamera, pencahayaan studio seimbang">
                <button class="btn-ai" onclick="generateAiMixMatch()">✨ AI Mix & Match (Ikuti Pose & Arahan Fotografer)</button>
            </div>

            <div class="slider-grid">
                <div class="slider-item">
                    <label><span>Ukuran</span><span id="lblScale">100%</span></label>
                    <input type="range" id="rngScale" min="55" max="160" value="100" oninput="updateTransform()">
                </div>
                <div class="slider-item">
                    <label><span>Rotasi</span><span id="lblRot">0°</span></label>
                    <input type="range" id="rngRot" min="-30" max="30" value="0" oninput="updateTransform()">
                </div>
                <div class="slider-item">
                    <label><span>Lebar Bahu</span><span id="lblWidth">100%</span></label>
                    <input type="range" id="rngWidth" min="75" max="135" value="100" oninput="updateTransform()">
                </div>
            </div>
        </section>

