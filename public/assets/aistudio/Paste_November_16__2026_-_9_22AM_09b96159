        function renderSwatches() {
            document.getElementById('skinSwatches').innerHTML = SKINS.map(hex =>
                `<div class="swatch ${state.model.skin === hex ? 'active' : ''}" style="background:${hex}" onclick="setSkin('${hex}')"></div>`
            ).join('');
            document.getElementById('bgSwatches').innerHTML = BACKDROPS.map((pair, idx) =>
                `<div class="swatch ${state.model.bgIdx === idx ? 'active' : ''}" style="background:linear-gradient(135deg,${pair[0]},${pair[1]})" onclick="setBg(${idx})"></div>`
            ).join('');
        }

        function renderSlotTabs() {
            document.getElementById('slotTabs').innerHTML = SLOTS.map(s =>
                `<button class="slot-tab ${state.activeTab === s.id ? 'active' : ''}" onclick="selectTab('${s.id}')">${s.name}</button>`
            ).join('');
        }

        function renderFilters() {
            document.getElementById('filterPills').innerHTML = FILTERS.map(f =>
                `<button class="pill ${state.filter === f.id ? 'active' : ''}" onclick="selectFilter('${f.id}')">${f.name}</button>`
            ).join('');
        }

        function renderTray() {
            const tray = document.getElementById('trayGrid');
            if (state.equipped.fullset) {
                const fs = state.equipped.fullset;
                const ac = state.equipped.accessory;
                tray.innerHTML = `
                    <div class="tray-slot active" style="grid-column:span 2;" onclick="selectTab('fullset')">
                        <div style="display:flex;align-items:center;gap:7px;min-width:0;">
                            <span class="dot" style="background:${fs.color}"></span>
                            <div class="tray-info"><small>Setelan Lengkap</small><strong>${fs.item.name}</strong></div>
                        </div>
                        <button class="btn" style="padding:2px 6px;" onclick="event.stopPropagation();unequip('fullset')">×</button>
                    </div>
                    <div class="tray-slot" style="grid-column:span 2;" onclick="selectTab('accessory')">
                        <div style="display:flex;align-items:center;gap:7px;min-width:0;">
                            <span class="dot" style="background:${ac ? ac.color : '#27272a'}"></span>
                            <div class="tray-info"><small>Aksesori</small><strong>${ac ? ac.item.name : 'Kosong'}</strong></div>
                        </div>
                        ${ac ? `<button class="btn" style="padding:2px 6px;" onclick="event.stopPropagation();unequip('accessory')">×</button>` : ''}
                    </div>`;
                return;
            }

            tray.innerHTML = ['top', 'bottom', 'outer', 'accessory'].map(k => {
                const meta = SLOTS.find(s => s.id === k);
                const eq = state.equipped[k];
                return `
                    <div class="tray-slot ${state.activeTab === k ? 'active' : ''}" onclick="selectTab('${k}')">
                        <div style="display:flex;align-items:center;gap:7px;min-width:0;">
                            <span class="dot" style="background:${eq ? eq.color : '#27272a'}"></span>
                            <div class="tray-info"><small>${meta.name}</small><strong>${eq ? eq.item.name : 'Kosong'}</strong></div>
                        </div>
                        ${eq ? `<button class="btn" style="padding:2px 6px;" onclick="event.stopPropagation();unequip('${k}')">×</button>` : ''}
                    </div>`;
            }).join('');
        }

        function renderColorSwatches() {
            const meta = SLOTS.find(s => s.id === state.activeTab);
            document.getElementById('lblSlotColor').textContent = `Warna ${meta.name}:`;
            const eq = state.equipped[state.activeTab];
            const cur = eq ? eq.color : '#1d4ed8';
            document.getElementById('nativeColorPicker').value = cur;
            document.getElementById('slotColorSwatches').innerHTML = PALETTE.map(hex =>
                `<div class="swatch ${cur.toLowerCase() === hex.toLowerCase() ? 'active' : ''}" style="background:${hex}" onclick="setSlotColor('${hex}')"></div>`
            ).join('');
        }

        function renderItems() {
            const list = WARDROBE[state.activeTab] || [];
            const filtered = state.filter === 'all' ? list : list.filter(i => i.tag === state.filter);
            const cur = state.equipped[state.activeTab];
            document.getElementById('itemsGrid').innerHTML = filtered.map(item => {
                const sel = cur && cur.item.id === item.id;
                return `
                    <div class="item-card ${sel ? 'selected' : ''}" onclick="equip('${state.activeTab}','${item.id}')">
                        <div class="item-top">
                            <span class="dot" style="background:${item.color}; width:16px; height:16px;"></span>
                            <span class="item-tag">${item.tag}</span>
                        </div>
                        <h4>${item.name}</h4>
                        <p>${item.desc}</p>
                    </div>`;
            }).join('');
        }

        // 4. INTERAKSI KONTROL
        function selectTab(id) {
            state.activeTab = id;
            renderSlotTabs();
            renderTray();
            renderColorSwatches();
            renderItems();
        }
        function selectFilter(id) {
            state.filter = id;
            renderFilters();
            renderItems();
        }
        function equip(slot, id) {
            const item = WARDROBE[slot].find(x => x.id === id);
            if (!item) return;
            state.aiResultImg = null;
            document.getElementById('btnBackOverlay').classList.add('hidden');
            document.getElementById('canvasStatusTitle').textContent = 'Pratinjau Studio';
            if (slot === 'fullset') {
                state.equipped.top = state.equipped.bottom = state.equipped.outer = null;
                state.equipped.fullset = { item, color: item.color };
            } else {
                if (['top', 'bottom', 'outer'].includes(slot)) state.equipped.fullset = null;
                state.equipped[slot] = { item, color: item.color };
            }
            renderTray(); renderColorSwatches(); renderItems(); draw();
        }
        function unequip(slot) {
            state.aiResultImg = null;
            state.equipped[slot] = null;
            renderTray(); renderItems(); draw();
        }
        function setSlotColor(hex) {
            if (!state.equipped[state.activeTab]) {
                equip(state.activeTab, WARDROBE[state.activeTab][0].id);
            }
            state.aiResultImg = null;
            state.equipped[state.activeTab].color = hex;
            renderTray(); renderColorSwatches(); draw();
        }

        function setSubjectMode(m) {
            state.mode = m;
            state.aiResultImg = null;
            document.getElementById('btnModeAi').classList.toggle('active', m === 'ai');
            document.getElementById('btnModeUpload').classList.toggle('active', m === 'upload');
            const pAi = document.getElementById('panelAi');
            const pUp = document.getElementById('panelUpload');
            if (m === 'ai') {
                pAi.classList.remove('hidden');
                pAi.style.display = 'flex';
                pUp.classList.add('hidden');
            } else {
                pUp.classList.remove('hidden');
                pUp.style.display = 'flex';
                pAi.classList.add('hidden');
            }
            draw();
        }
        function updateModel() {
            state.aiResultImg = null;
            state.model.pose = document.getElementById('selPose').value;
            state.model.gender = document.getElementById('selGender').value;
            state.model.hair = document.getElementById('selHair').value;
            // Set proportional joint defaults per preset pose
            const presetJoints = {
                standing_front: { turn: 0, armL: 15, armR: 15, legSpread: 8 },
                side_casual: { turn: 16, armL: 10, armR: 28, legSpread: 12 },
                walking_runway: { turn: 8, armL: -18, armR: 25, legSpread: 20 },
                hand_on_hip: { turn: -8, armL: 58, armR: 12, legSpread: 10 },
                sitting_casual: { turn: 6, armL: 22, armR: 22, legSpread: 14 }
            };
            const j = presetJoints[state.model.pose] || presetJoints.standing_front;
            state.poseJoints = { ...j };
            syncPoseSliders();
            draw();
        }
        function updatePoseJoints() {
            state.aiResultImg = null;
            state.poseJoints.turn = +document.getElementById('rngBodyTurn').value;
            state.poseJoints.armL = +document.getElementById('rngArmL').value;
            state.poseJoints.armR = +document.getElementById('rngArmR').value;
            state.poseJoints.legSpread = +document.getElementById('rngLegSpread').value;
