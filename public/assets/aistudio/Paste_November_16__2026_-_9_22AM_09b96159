            state.faceAdjust.touchup = document.getElementById('selFaceTouchup').value;
            document.getElementById('lblBright').textContent = state.faceAdjust.brightness + '%';
            document.getElementById('lblContrast').textContent = state.faceAdjust.contrast + '%';
            document.getElementById('lblWarmth').textContent = (state.faceAdjust.warmth > 0 ? '+' : '') + state.faceAdjust.warmth + '%';
